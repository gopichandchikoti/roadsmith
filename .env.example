# Roadsmith server settings. Names only: this app holds no secrets.
# Copy to .env for local use. .env is ignored by git.

# "production" in a deployment. Production start-up refuses a missing or non-https PUBLIC_ORIGIN.
NODE_ENV=

# Port to listen on. Defaults to 4620.
PORT=

# Interface to bind. Defaults to 127.0.0.1 in development and 0.0.0.0 in production.
HOST=

# Required in production: the https origin visitors use, with no path (for example https://roadsmith.example.com).
PUBLIC_ORIGIN=

# Trusted reverse proxy addresses, comma separated: IPs, CIDR ranges or "loopback". A bare hop count is refused.
TRUST_PROXY=
