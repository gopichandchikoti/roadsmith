{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "server/**",
      "scripts/**",
      "tests/**",
      "*.json",
      "*.mjs",
      "*.ts",
      "!src/content.model.json",
      "!src/catalog.model.json",
      "!src/legal.model.json",
      "!src/themes/motion.css",
      "!validation/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 130,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": { "formatter": { "enabled": true } },
  "json": { "formatter": { "enabled": true } },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
