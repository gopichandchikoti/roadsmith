{
  "name": "roadsmith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Roadside fix finder: name the problem, get a verdict, the tools and the steps.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server \"vite\" \"tsx watch server/index.ts\"",
    "build": "pnpm typecheck && tsc -p tsconfig.server.build.json && vite build && node scripts/precompress.mjs",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "motion:generate": "tsx scripts/generate-motion.ts",
    "test": "pnpm test:unit && pnpm test:ui && pnpm test:server && pnpm test:security",
    "test:unit": "tsx --tsconfig tsconfig.app.json --test tests/unit/*.test.ts",
    "test:ui": "tsx --tsconfig tsconfig.app.json --import ./tests/setup/css.mjs --test tests/ui/*.test.tsx",
    "test:server": "tsx --tsconfig tsconfig.server.json --test tests/server/*.test.ts",
    "test:security": "tsx --tsconfig tsconfig.server.json --test tests/security/*.test.ts",
    "test:build": "node --test tests/build/*.test.mjs",
    "deps:audit": "pnpm audit --prod",
    "audit:standards": "node scripts/audit-standards.mjs"
  },
  "packageManager": "pnpm@11.28.3",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tabler/icons-react": "^3.50.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "21.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "26.1.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
